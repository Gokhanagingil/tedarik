# Kopyalayıp .env olarak kullanın; .env Git'e girmez.
TEDARIK_AUTH_MODE=dev
TEDARIK_DB=tedarik.db
# PostgreSQL (üretim): verilirse SQLite yerine kullanılır. Üretimde adresi dosyadan okuyun.
# TEDARIK_DATABASE_URL=postgresql://tedarik@127.0.0.1:5432/tedarik
# TEDARIK_DATABASE_URL_FILE=/run/secrets/tedarik_database_url
# TEDARIK_DB_SCHEMA=tedarik
TEDARIK_HOST=127.0.0.1
PORT=8090
TEDARIK_MODULES=core,performance,surveys,risks,transfer,dashboard
# MCP anahtarı: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# TEDARIK_API_KEY_FILE=/run/secrets/tedarik_api_key
